PORT=4173
HOST=127.0.0.1
# Production: fixed HTTPS origin and immediate proxy IP, configured together.
# Keep HOST on loopback when the TLS proxy runs on this server.
# SAQ_PUBLIC_ORIGIN=https://saq.example.kz
# SAQ_TRUSTED_PROXY_IP=127.0.0.1
SAQ_DB_PATH=./data/saq-qurylys.sqlite
# working requires a separate empty database and an ADMIN account created before startup.
SAQ_DATA_MODE=demo
AI_PROVIDER=local-ml
AI_API_KEY=
AI_MODEL=gpt-4.1-mini
# AI_API_KEY is for OpenAI only; DeepSeek must use its own provider key.
# DEEPSEEK_API_KEY=
AI_TIMEOUT_MS=12000
# Comma-separated additional non-working dates, maintained by the operator.
SAQ_NON_WORKING_DATES=

# Optional credential for an administrator-configured JSON_FEED source.
# Source configuration stores tokenEnv=SAQ_SOURCE_PUBLICATIONS_TOKEN, never its value.
# SAQ_SOURCE_PUBLICATIONS_TOKEN=

# Optional HTML screenshot renderer. Both paths must be absolute and operator-controlled.
# Install Playwright and a compatible Chromium/Edge separately; no browser is downloaded at startup.
# SAQ_CAPTURE_PLAYWRIGHT_PATH=C:/path/to/playwright
# SAQ_CAPTURE_BROWSER_PATH=C:/Program Files (x86)/Microsoft/Edge/Application/msedge.exe
